// ─────────────────────────────────────────────────────────────────────────────
// EL KRATOS EMBASSY — Prisma Schema
// Database: PostgreSQL (hosted on Coolify)
//
// Tables:
//   subscribers   — newsletter email list (migrated from MongoDB)
//   quiz_attempts — BFC assessment results
//   questions     — BFC question bank, one set per batch
//   quiz_participants — members allowed to sit a batch
//   quiz_settings — facilitator-controlled time limit per batch
//   quiz_attempts.questionSnapshot — the paper as it was when the attempt was scored
//   fruit_game_* — live Fruit Games arena for one session code
//
// Future Cornerstone (EKE-CMS) tables will be added to this same schema.
// The membershipId field on quiz_attempts is a stable FK to the future
// members table — do not rename it.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Newsletter subscribers ────────────────────────────────────────────────────
// Replaces the MongoDB collection.
// unsubscribedAt is nullable — null means currently subscribed.
model Subscriber {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  subscribed     Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@map("subscribers")
}

// ── BFC Quiz attempts ─────────────────────────────────────────────────────────
// membershipId = ELKE-YYYY-XXXX — stable FK for future Cornerstone migration.
// One attempt per member per batch enforced at DB level.
model QuizAttempt {
  id               Int      @id @default(autoincrement())
  membershipId     String
  name             String
  batch            String
  answers          Json
  questionSnapshot Json?
  score            Int
  percentage       Int
  passed           Boolean
  submittedAt      DateTime @default(now())

  @@unique([membershipId, batch])
  @@index([batch])
  @@map("quiz_attempts")
}

// ── BFC question bank ─────────────────────────────────────────────────────────
// Questions belong to a batch. order is the display sequence within that batch.
// answerIndex is 0-based and is never returned by the public quiz fetch.
model Question {
  id          Int      @id @default(autoincrement())
  batch       String
  weekLabel   String
  order       Int
  text        String
  options     Json
  answerIndex Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([batch, order])
  @@index([batch, order])
  @@map("questions")
}

// ── Members allowed to sit a batch ────────────────────────────────────────────
// Facilitators manage this list. membershipId stays stable for Cornerstone.
model QuizParticipant {
  id            Int      @id @default(autoincrement())
  membershipId  String
  name          String
  batch         String
  fruitAlliance String?
  createdAt     DateTime @default(now())

  @@unique([membershipId, batch])
  @@index([batch])
  @@map("quiz_participants")
}

// ── Facilitator settings for a batch ──────────────────────────────────────────
// durationMinutes is the personal countdown. opensAt/closesAt is the window
// when candidates are allowed to begin. Null means the quiz is not open.
model QuizSetting {
  id              Int       @id @default(autoincrement())
  batch           String    @unique
  durationMinutes Int       @default(45)
  opensAt         DateTime?
  closesAt        DateTime?
  updatedAt       DateTime  @updatedAt

  @@map("quiz_settings")
}

// In-progress sitting. startedAt does not reset if the candidate refreshes
// or closes the tab. questionSnapshot is the paper frozen at the start.
// Cleared once the attempt is submitted.
model QuizProgress {
  id               Int      @id @default(autoincrement())
  membershipId     String
  name             String
  batch            String
  startedAt        DateTime @default(now())
  answers          Json
  questionSnapshot Json?
  questionIndex    Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([membershipId, batch])
  @@index([batch])
  @@map("quiz_progress")
}

// ── Fruit Games ───────────────────────────────────────────────────────────────
// One session per event. Alliance screens and the public board share that code.
model FruitGameSession {
  id         String   @id @default(cuid())
  code       String   @unique
  label      String
  isActive   Boolean  @default(false)
  isLocked   Boolean  @default(false)
  revealMode Boolean  @default(false)
  prize1     String   @default("Fruit Games 2026 Champions — ₦10,000 🎉")
  prize2     String   @default("Walking in the Spirit — ₦6,000 💪")
  prize3     String   @default("The Comeback is Coming — ₦4,000 😊")
  defaultTimerSeconds Int      @default(60)
  createdAt           DateTime @default(now())

  scores       FruitGameScore[]
  questions    FruitGameQuestion[]
  buzzEvents   FruitGameBuzz[]
  attestations FruitGameAttestation[]
  knowYourself FruitGameKnowYourself[]

  @@map("fruit_game_sessions")
}

model FruitGameScore {
  id        String   @id @default(cuid())
  sessionId String
  alliance  String
  points    Int      @default(0)
  updatedAt DateTime @updatedAt

  session FruitGameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, alliance])
  @@map("fruit_game_scores")
}

model FruitGameQuestion {
  id           String    @id @default(cuid())
  sessionId    String
  order        Int
  text         String
  section      String    @default("Round")
  mode         String    @default("buzzer")
  points       Int       @default(10)
  doublePoints Boolean   @default(false)
  timerSeconds Int       @default(30)
  options      Json?
  answerIndex  Int?
  isActive     Boolean   @default(false)
  isDone       Boolean   @default(false)
  openedAt     DateTime?
  createdAt    DateTime  @default(now())

  session    FruitGameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  buzzEvents FruitGameBuzz[]

  @@index([sessionId, order])
  @@map("fruit_game_questions")
}

// One winning buzz per question. Reset deletes the row so the next attempt can land.
model FruitGameBuzz {
  id         String   @id @default(cuid())
  sessionId  String
  questionId String   @unique
  alliance      String
  memberName    String
  selectedIndex Int?
  buzzedAt      DateTime @default(now())

  session  FruitGameSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question FruitGameQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("fruit_game_buzz_events")
}

model FruitGameKnowYourself {
  id         String   @id @default(cuid())
  sessionId  String
  memberName String
  alliance   String
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())

  session FruitGameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("fruit_game_know_yourself")
}

// One reaction per member per hot-seat call.
model FruitGameAttestation {
  id          String   @id @default(cuid())
  sessionId   String
  subjectName String
  memberName  String
  reaction    String
  createdAt   DateTime @default(now())

  session FruitGameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, subjectName, memberName])
  @@map("fruit_game_attestations")
}
